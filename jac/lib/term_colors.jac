# ANSI terminal color codes for vivid demo output in Terminal 1.

glob RESET    = "\033[0m";
glob BOLD     = "\033[1m";
glob DIM      = "\033[2m";

glob FG_GREEN   = "\033[92m";
glob FG_YELLOW  = "\033[93m";
glob FG_RED     = "\033[91m";
glob FG_BLUE    = "\033[94m";
glob FG_CYAN    = "\033[96m";
glob FG_MAGENTA = "\033[95m";
glob FG_WHITE   = "\033[97m";
glob FG_GRAY    = "\033[90m";

glob BG_GREEN  = "\033[42m";
glob BG_YELLOW = "\033[43m";
glob BG_RED    = "\033[41m";
glob BG_BLUE   = "\033[44m";
glob BG_BLACK  = "\033[40m";

glob SEP = "\033[90m" + "------------------------------------------------------------" + "\033[0m";
